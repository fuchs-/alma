<Window x:Class="Alma.Debugger.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ALMA Debugger" 
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        
        Loaded="MainWindow_OnLoaded">
    <Grid>
        <DataGrid ItemsSource="{Binding People}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}" 
                                    Width="130"
                                    ElementStyle="{StaticResource DataGridFirstColumn}">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader"
                               BasedOn="{StaticResource HeaderStyle}">
                            <Setter Property="Padding"
                                    Value="10,0,0,0"></Setter>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
                <DataGridTextColumn
                    Header="Age"
                    Binding="{Binding Age}"
                    Width="50"
                    ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn
                    Header="Tension"
                    Binding="{Binding Tension}"
                    Width="70"
                    ElementStyle="{StaticResource DataGridCellText}"/>
                <DataGridTextColumn
                    Header="Activity"
                    Binding="{Binding Activity}"
                    Width="180"
                    ElementStyle="{StaticResource DataGridCellText}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
