<Application x:Class="Alma.Debugger.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="/Views/MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#141519" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1E24" />
        <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#252831" />
        
        <SolidColorBrush x:Key="BorderBrush" Color="#30323A" />
        
        <SolidColorBrush x:Key="ForegroundBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#9296A2" />
        
        <!-- Arasaka Red -->
        <SolidColorBrush x:Key="AccentBrush" Color="#E53945" />
        
        <Style x:Key="HeaderStyle"
               TargetType="DataGridColumnHeader">
            <Setter 
                Property="Background"
                Value="{StaticResource SurfaceBrush}"/>
        </Style>
        
        <Style TargetType="DataGrid">
            <Setter Property="ColumnHeaderStyle"
                    Value="{StaticResource HeaderStyle}"></Setter>
            <Setter
                Property="Background"
                Value="{StaticResource BackgroundBrush}"/>
            <Setter
                Property="Foreground"
                Value="{StaticResource ForegroundBrush}"/>
            <Setter 
                Property="BorderBrush"
                Value="{StaticResource BorderBrush}"/>
            
            <Setter 
                Property="RowBackground"
                Value="{StaticResource BackgroundBrush}"/>
            
            <Setter
                Property="GridLinesVisibility"
                Value="Horizontal"/>
            <Setter
                Property="HorizontalGridLinesBrush"
                Value="{StaticResource BorderBrush}"/>
            <Setter
                Property="HeadersVisibility"
                Value="Column"/>
            <Setter
                Property="RowHeight"
                Value="36"/>
            <Setter
                Property="AutoGenerateColumns"
                Value="False"/>
        </Style>
        
        <Style TargetType="DataGridRow">
            
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridRow}">
                        <Border Background="{TemplateBinding Background}">
                            <Grid>
                                <Border 
                                    x:Name="SelectionIndicator"
                                    Background="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Left"
                                    Width="3"
                                    Visibility="Collapsed"/>
                                <DataGridCellsPresenter/>    
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter 
                                    TargetName="SelectionIndicator"
                                    Property="Visibility"
                                    Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter 
                        Property="Background"
                        Value="{StaticResource SurfaceBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter
                        Property="Background"
                        Value="{StaticResource ElevatedSurfaceBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="DataGridCell">
            <Style.Triggers>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter
                        Property="Background"
                        Value="Transparent"/>
                    <Setter
                        Property="BorderBrush"
                        Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="DataGridCellText"
               TargetType="TextBlock">
            <Setter 
                Property="VerticalAlignment"
                Value="Center"/>
        </Style>
        <Style x:Key="DataGridFirstColumn"
               TargetType="TextBlock"
               BasedOn="{StaticResource DataGridCellText}">
            <Setter 
                Property="Padding"
                Value="5,0,0,0"/>
        </Style>
    </Application.Resources>
</Application>
